    (effects
      (font
        (size 1.02 1.02))
      (justify left bottom))
    (uuid "35c647bb-2f5e-51d9-a793-416ee4baf8e8"))
  (text "ADC_L → IC1.32 (GP27), ADC_R → IC1.31 (GP26). Сигнал: DC 0–3.3 В, пульсации 80–1000 Гц, до 0.4 В p-p (R_IS 10k, см. README)."
    (at 40.64 105.66 0)
    (effects
      (font
        (size 1.02 1.02))
      (justify left bottom))
